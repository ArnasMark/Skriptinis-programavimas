%1. Trimatis grafikų vaizdavimas

%A)

x = (2*rand(1,200)-1)*sqrt(pi/2);
y = (2*rand(1,200)-1)*sqrt(pi/2);
z = sin(x.^2 + y.^2);

tri = delaunay(x,y);

figure(1);
trisurf(tri,x,y,z);

colormap parula;


shading interp;

xlabel('x');
ylabel('y');
zlabel('f(x,y)');

title('f(x,y) = sin(x^2 + y^2)');

axis([min(x) max(x) min(y) max(y) min(z) max(z)]);

view(15,15);

grid on;

%% B)

x = -1:0.02:1;
y = -1:0.02:1;

[X,Y] = meshgrid(x,y);

r = sqrt(X.^2 + Y.^2);

Z = exp(r.^2);

figure(2);
surf(X,Y,Z);

colormap parula;

shading interp;

xlabel('x');
ylabel('y');
zlabel('z(r)');

title('z(r) = e^{r^2}');

axis([-1 1 -1 1 min(Z(:)) max(Z(:))]);

view(20,20);

grid on;

% P. Funkcijos paviršiaus atvaizdavimas

% x ir y reikšmių intervalai
x = linspace(-2, 2, 50);
y = linspace(-2, 2, 50);



% Duota funkcija
Z = 1 - (X.^2 + Y.^2);

% Sukuriame vieną langą su 3 grafikais
figure;

% ---------------- 1 GRAFIKAS ----------------
subplot(1,3,1);

surf(X, Y, Z, 'EdgeColor', 'none', 'FaceColor', 'g')

xlabel('x');
ylabel('y');
zlabel('z');
title('zalias');
grid on;
view(45,30);


subplot(1,3,2);

surf(X, Y, Z, ...
    'EdgeColor', 'none', 'FaceColor', 'b');

xlabel('x');
ylabel('y');
zlabel('z');
title('melynas');
grid on;
view(45,30);


subplot(1,3,3);

surf(X, Y, Z, 'EdgeColor', 'none', 'FaceColor', 'r');

colormap(gca, [1 0 0]);

xlabel('x');
ylabel('y');
zlabel('z');
title('raudonas');
